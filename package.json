{
  "name": "repo-control-center",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/harden-csp.mjs",
    "build:pages": "ng build --base-href /repo-status-dashboard/ && node scripts/harden-csp.mjs",
    "collect": "node scripts/collect-github-status.mjs",
    "lifecycle:refresh": "node scripts/update-lifecycle-cache.mjs",
    "lifecycle:refresh:force": "node scripts/update-lifecycle-cache.mjs --force",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:app && npm run test:collector",
    "test:app": "ng test --watch=false",
    "test:collector": "node --test scripts/*.test.mjs"
  },
  "private": true,
  "license": "MIT",
  "description": "Operational dashboard for GitHub repositories",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0"
  }
}
